# VoiceOps configuration. Copy to backend/.env (local) or .env (docker compose) and adjust.
# Never commit real keys.

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql+asyncpg://voiceops:voiceops@localhost:5432/voiceops
AUTO_SEED=true
# true = never contact Hugging Face at startup (models must already be cached; the Docker image bakes them in)
MODELS_OFFLINE=false

# ── Auth ──
# At least 32 characters. Outside APP_ENV=development a missing/weak secret is replaced by a random one.
JWT_SECRET=change-me-to-a-long-random-string
APP_ENV=development
# Self-registered accounts are read-only "viewer"s with masked customer PII; false disables sign-up.
REGISTRATION_ENABLED=true
JWT_EXPIRATION_MINUTES=1440

# ── LLM (any OpenAI-compatible chat API with tool calling) ──
# LLM_PROVIDER: auto | openai | offline   (auto = use LLM if LLM_BASE_URL or LLM_API_KEY is set)
LLM_PROVIDER=auto
# Local Ollama (free):   LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:3b
# OpenAI:                LLM_BASE_URL=                            LLM_MODEL=gpt-4o-mini  LLM_API_KEY=sk-...
# Groq:                  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# ── Speech-to-Text ──
# STT_PROVIDER: auto | openai | local | browser
#   local  = Whisper on CPU via transformers (no key; model downloads on first use)
#   openai = OpenAI-compatible Whisper API (OpenAI, or Groq with STT_BASE_URL + STT_MODEL=whisper-large-v3-turbo)
STT_PROVIDER=auto
STT_LOCAL_MODEL=openai/whisper-base.en
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# ── Text-to-Speech ──
# TTS_PROVIDER: auto | openai | edge | browser   (edge = free Microsoft neural voices, needs internet)
TTS_PROVIDER=auto
TTS_EDGE_VOICE=en-US-AriaNeural
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy

# ── RAG ──
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=3
RAG_MIN_SCORE=0.40

# ── App ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
